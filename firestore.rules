rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Live match scores. Anyone with the link can read one match (no listing).
    // Only the anonymous user who created a match can write it.
    match /matches/{id} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.keys().hasOnly(['owner', 'createdAt', 'updatedAt', 'data'])
        && request.resource.data.data is map;
      allow update: if request.auth != null
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.keys().hasOnly(['owner', 'createdAt', 'updatedAt', 'data'])
        && request.resource.data.data is map;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
